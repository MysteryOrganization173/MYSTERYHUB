# ============================================================
# Mystery Hub — Environment Variables Template
# Copy this file to .env.local and fill in your values
# ============================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Mystery Hub"
NEXT_PUBLIC_APP_DESCRIPTION="Digital services platform for connectivity, mobile services, and more"

# Supabase
# Required as of the V1 backend foundation phase — see supabase/README.md
# and docs/v1-implementation-plan.md. The service role key is server-only:
# never prefix it with NEXT_PUBLIC_ and never import it into client code
# (src/lib/supabase/admin.ts enforces this at runtime).
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Stripe — scaffolded only, not wired to anything. Paystack (below) is the
# live V1 payment rail — see docs/payment-flow.md.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Paystack (for payments) — see docs/payment-flow.md
# PAYSTACK_SECRET_KEY is server-only: never prefix it with NEXT_PUBLIC_.
# It is used both to call the Paystack API and to verify webhook signatures
# (Paystack has no separate webhook secret).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@mysterybundlehub.com

# SuccessBizHub (catalogue + fulfillment supplier) — see
# docs/product-audit.md. No public API docs exist for SuccessBizHub; the
# wire shapes in src/services/suppliers/successBizHub/ are written
# defensively and may need correction once real docs/sandbox access exist.
# SUCCESSBIZHUB_API_KEY is server-only: never prefix with NEXT_PUBLIC_.
SUCCESSBIZHUB_BASE_URL=https://api.successbizhub.com/v1
SUCCESSBIZHUB_API_KEY=your_successbizhub_api_key_here
SUCCESSBIZHUB_REQUEST_TIMEOUT_MS=8000

# Cloudinary (brand imagery / media delivery). CLOUDINARY_API_KEY /
# CLOUDINARY_API_SECRET are server-only: never prefix with NEXT_PUBLIC_ — they
# are only needed to run `npm run assets:upload` (scripts/upload-brand-assets.mjs).
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME is not a secret (it's part of every
# delivery URL) and is what src/components/shared/BrandImage.tsx checks to
# decide whether to render a Cloudinary-hosted CldImage or fall back to the
# generated asset already committed under public/images/**. Until this is
# set, the site works fully off the local fallback images — see
# docs/product-audit.md ("Phase 7 — Visual assets").
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# Admin allowlist — comma-separated, case-insensitive. Server-only: never
# prefix with NEXT_PUBLIC_. See docs/authentication.md. An unconfigured
# allowlist fails closed (nobody is an admin), never open.
ADMIN_EMAILS=owner@example.com,ops@example.com

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Feature Flags
NEXT_PUBLIC_ENABLE_REFERRALS=true
NEXT_PUBLIC_ENABLE_AFFILIATES=true
NEXT_PUBLIC_MAINTENANCE_MODE=false
